# Axiom MCP server — environment (Spec §1)
#
# Point at the AXIOM Supabase project only — never the Nexus/VenueOS project.
# Authenticate as a DEDICATED Axiom user (e.g. mcp@relicbuilt.com), NOT the
# service-role key: writes stay attributable in activity_log and RLS still
# constrains the blast radius. Copy this file to `.env` and fill in real values.

AXIOM_SUPABASE_URL=
AXIOM_SUPABASE_ANON_KEY=
AXIOM_MCP_USER_EMAIL=
AXIOM_MCP_USER_PASSWORD=

# The workspace this server acts in: `wallflower_relic` or `relic`.
# Sent as the x-axiom-tenant header so Phase 2 tenancy RLS can resolve the
# tenant (current_tenant_id). The MCP user must be an active member of it.
AXIOM_TENANT=wallflower_relic
